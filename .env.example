# PostgreSQL
POSTGRES_USER=viper_user
POSTGRES_PASSWORD=viper_password
POSTGRES_DB=viper_db
DATABASE_URL=postgresql://viper_user:viper_password@localhost:5432/viper_db
AUTO_CREATE_TABLES=true

# Frontend/backend URLs used during local development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Google OpenID Connect
GOOGLE_CLIENT_ID=In-Google-Cloud-Auth-Platform
GOOGLE_CLIENT_SECRET=In-Google-Cloud-Auth-Platform
SESSION_SECRET=replace-with-a-long-random-string
VIPER_ADMIN_EMAILS=admin@example.com,admin2@example.com
